{
  "name": "mockapi-dev-tools",
  "private": true,
  "scripts": {
    "hooks:install": "node ./scripts/install-git-hooks.cjs",
    "postinstall": "node -e \"require('./scripts/lib/pnpm-lock-registry.cjs').normalizeWorkingLockfile()\"",
    "prepare": "pnpm run hooks:install",
    "format": "prettier --write . && dotnet format MockAPI.slnx",
    "format:check": "prettier --check . && dotnet format MockAPI.slnx --verify-no-changes",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules/**\" \"#artifacts/**\" \"#**/bin/**\" \"#**/obj/**\"",
    "lint": "pnpm run format:check && pnpm run lint:markdown && pnpm run validate:ci-policy",
    "test:frontend": "vitest run",
    "test:frontend:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test --grep @smoke",
    "test:site": "playwright test --config playwright.site.config.js",
    "build:site": "node ./scripts/build-site.cjs",
    "validate:ci-policy": "pnpm run validate:workflow-pins",
    "validate:dependency-age": "pwsh ./scripts/Test-DependencyAge.ps1",
    "validate:dependency-security": "pwsh ./scripts/Test-DependencyVulnerabilities.ps1",
    "validate:version": "node ./scripts/release-version.cjs check",
    "validate:workflow-pins": "pwsh ./scripts/Test-WorkflowPins.ps1"
  },
  "engines": {
    "node": ">=26",
    "pnpm": "12.8.2"
  },
  "packageManager": "pnpm@12.8.2",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.61.1",
    "@vitest/coverage-v8": "5.0.3",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "vitest": "5.0.3"
  }
}
