{
  "default": true,
  "MD013": false,
  // Keep a Changelog repeats category headings under distinct releases; duplicates under one parent remain invalid.
  "MD024": { "siblings_only": true },
  // GitHub-native shell selectors use disclosure controls because GFM has no tab primitive.
  // Keep raw HTML prohibited except for the three elements required by that pattern.
  "MD033": { "allowed_elements": ["details", "summary", "strong"] },
  "MD060": { "style": "aligned" },
}
