# Placeholder-only template. Copy to .env for local use; never commit real IDs or credentials.
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus2
AZURE_ENV_NAME=mockapi-dev

# Azure Custom Domain Configuration
# CNAME for a subdomain; HTTP for an apex domain with an A record.
AZURE_CUSTOM_DOMAIN=
AZURE_CUSTOM_DOMAIN_VALIDATION_METHOD=CNAME

# MockAPI Dashboard credentials. Leave blank if keeping it publicly accessible
AZURE_DASHBOARD_USERNAME=
AZURE_DASHBOARD_PASSWORD=

# Optional initial X-MockAPI-Key: 32-256 ASCII letters, digits, hyphens, or underscores.
# After copying: .\start.ps1 -Action azure-generate-key
# Bash equivalent: ./start.sh --action azure-generate-key
# Existing persisted security settings take precedence.
AZURE_MOCKAPI_KEY=
