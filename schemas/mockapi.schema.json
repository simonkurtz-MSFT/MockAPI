{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mockapi.local/schemas/mockapi.schema.json",
  "title": "MockAPI configuration",
  "description": "Configuration for exact HTTP mock endpoints. The x-maximum*Utf8Bytes annotations are enforced by MockAPI semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "endpoints"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "endpoints": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/endpoint"
      }
    }
  },
  "x-maximumUtf8Bytes": 4194304,
  "$defs": {
    "httpToken": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
    },
    "headerValue": {
      "type": "string",
      "pattern": "^[^\\r\\n]*$",
      "x-maximumUtf8Bytes": 8192
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "enabled", "methods", "path", "response"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "enabled": {
          "type": "boolean"
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/httpToken"
          }
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/"
        },
        "response": {
          "$ref": "#/$defs/response"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statusCode", "headers", "body"],
      "properties": {
        "statusCode": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "reasonPhrase": {
          "type": ["string", "null"],
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "headers": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/httpToken"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/headerValue"
            }
          },
          "x-maximumCombinedUtf8Bytes": 32768
        },
        "contentType": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$"
        },
        "body": {
          "type": "string",
          "x-maximumUtf8Bytes": 1048576
        }
      }
    }
  }
}
