<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
    <PublishSingleFile Condition="'$(PublishAot)' != 'true'">true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableCompressionInSingleFile Condition="'$(PublishAot)' != 'true'">true</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);1591</WarningsAsErrors>
    <Version>1.9.0</Version>
    <BuildDateUtc Condition="'$(BuildDateUtc)' == ''">$([System.DateTime]::UtcNow.ToString('O'))</BuildDateUtc>
    <RepositoryUrl>https://github.com/simonkurtz-MSFT/MockAPI</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDateUtc" Value="$(BuildDateUtc)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\config\trailhead-aoai.json" LogicalName="MockAPI.BuiltIns.trailhead-aoai.json" />
    <EmbeddedResource Include="..\..\config\trailhead-inventory.json" LogicalName="MockAPI.BuiltIns.trailhead-inventory.json" />
    <EmbeddedResource Include="..\..\config\trailhead-shipping.json" LogicalName="MockAPI.BuiltIns.trailhead-shipping.json" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Remove="**\*.security.json;**\*.security.json.*.tmp" />
  </ItemGroup>

  <Target Name="RemovePublishedSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)**/*.pdb;$(PublishDir)**/*.dbg" />
      <PublishedDocumentation Include="$(PublishDir)$(AssemblyName).xml" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
    <Delete Files="@(PublishedDocumentation)" />
  </Target>

</Project>
